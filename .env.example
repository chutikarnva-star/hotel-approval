# Postgres connection string (Launchpad provisions this in production)
DATABASE_URL="postgresql://hotel_approval:hotel_approval_dev@localhost:5432/hotel_approval"

# Firebase client config (from Firebase console > Project settings > General)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase admin (server-side token verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated list of email domains allowed to sign in, e.g. @cjmart.co.th
# Add extra domains (e.g. @gmail.com) locally for your own testing only.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=@cjmart.co.th

# Comma-separated list of full email addresses allowed to access /admin
ADMIN_EMAILS=
